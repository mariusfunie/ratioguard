# RatioGuard - Environment Variables
# Copiaza acest fisier in .env si completeaza valorile

# -----------------------------------------------
# General
# -----------------------------------------------
SECRET_KEY=your-random-secret-key-here
DATABASE_PATH=/data/ratioguard.db

# -----------------------------------------------
# Transmission
# -----------------------------------------------
TRANSMISSION_URL=http://localhost:9091/transmission/rpc
TRANSMISSION_USER=your-transmission-username
TRANSMISSION_PASS=your-transmission-password
